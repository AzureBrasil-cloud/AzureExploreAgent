{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<TENANT-ID>",
    "ClientId": "<APPLICATION-CLIENT-ID>",
    "AllowWebApiToBeAuthorizedByACL": true
  },
  "FoundryCaller": {
    "AllowedObjectIds": [ "<FOUNDRY-CALLER-OBJECT-ID>" ]
  },
  "ServicePrincipal": {
    "TenantId": "<TENANT-ID>",
    "ClientId": "<APPLICATION-CLIENT-ID>",
    "ClientSecret": "<set via user secrets or environment variable>"
  },
  "Foundry": {
    "ProjectEndpoint": "https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT",
    "ModelDeploymentName": "<MODEL-DEPLOYMENT-NAME>"
  },
  "MicrosoftLearn": {
    "Endpoint": "https://learn.microsoft.com/api/mcp",
    "ConnectionTimeoutSeconds": 30
  },
  "AzureCli": {
    "ExecutablePath": "az",
    "SubscriptionId": "<SUBSCRIPTION-ID>",
    "TimeoutSeconds": 30,
    "LoginTimeoutSeconds": 90,
    "MaxOutputCharacters": 60000
  },
  "AgentInstructions": {
    "FilePath": "Instructions/azure-explore-agent.md"
  },
  "A2A": {
    "PublicBaseUrl": "https://YOUR-AGENT-HOST.example.com"
  }
}
